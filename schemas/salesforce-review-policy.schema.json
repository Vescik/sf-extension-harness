{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:sf-harness-brain-core:salesforce-review-policy.schema.json",
  "title": "Salesforce org-review runtime and fixed query policy",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "mcpProtocolVersion",
    "maxVendorPayloadBytes",
    "cliTimeoutSeconds",
    "restReadTimeoutSeconds",
    "operationTimeoutSeconds",
    "soqlQueryTimeoutSeconds",
    "profiles"
  ],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "schemaVersion": {
      "const": 3
    },
    "mcpProtocolVersion": {
      "const": "2025-06-18"
    },
    "maxVendorPayloadBytes": {
      "type": "integer",
      "minimum": 65536,
      "maximum": 1048576
    },
    "cliTimeoutSeconds": {
      "type": "integer",
      "minimum": 30,
      "maximum": 300
    },
    "restReadTimeoutSeconds": {
      "type": "integer",
      "minimum": 10,
      "maximum": 120
    },
    "operationTimeoutSeconds": {
      "type": "integer",
      "minimum": 60,
      "maximum": 600
    },
    "soqlQueryTimeoutSeconds": {
      "type": "integer",
      "minimum": 5,
      "maximum": 120
    },
    "profiles": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "installedPackages",
        "installedPackagesAll",
        "objectEntity",
        "objectFields"
      ],
      "properties": {
        "installedPackages": {
          "$ref": "#/$defs/packageProfile"
        },
        "installedPackagesAll": {
          "$ref": "#/$defs/fixedProfile"
        },
        "objectEntity": {
          "$ref": "#/$defs/objectProfile"
        },
        "objectFields": {
          "$ref": "#/$defs/objectProfile"
        }
      }
    }
  },
  "$defs": {
    "fixedProfile": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "useToolingApi",
        "query"
      ],
      "properties": {
        "useToolingApi": {
          "type": "boolean"
        },
        "query": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000
        }
      }
    },
    "objectProfile": {
      "allOf": [
        {
          "$ref": "#/$defs/fixedProfile"
        },
        {
          "properties": {
            "query": {
              "type": "string",
              "pattern": "\\$\\{OBJECT_API_NAME\\}"
            }
          }
        }
      ]
    },
    "packageProfile": {
      "allOf": [
        {
          "$ref": "#/$defs/fixedProfile"
        },
        {
          "properties": {
            "query": {
              "type": "string",
              "pattern": "\\$\\{PACKAGE_NAMESPACES\\}"
            }
          }
        }
      ]
    }
  }
}
