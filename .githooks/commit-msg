#!/bin/sh
# sf-harness commit-message validator
# The installer places a standalone validator beside this hook, outside the worktree.
hook_dir=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd) || exit 1
case "$(uname -s)" in
    MINGW*|MSYS*|CYGWIN*) python_command=python ;;
    *) python_command=python3 ;;
esac
exec "$python_command" "$hook_dir/sf-harness-git-message-policy.py" --message-file "$1"
